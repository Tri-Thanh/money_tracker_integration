<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <menuitem id="money_tracker_app_menu"
                  name="Money Tracker"
                  web_icon="money_tracker_integration,static/description/icon.png"
                  sequence="100">
            <menuitem id="money_tracker_all_transactions"
                      name="Transactions"
                      sequence="1"
                      action="money_tracker_integration.action_open_mt_transaction"
            />
            <menuitem id="money_tracker_app_configuration"
                      name="Configuration"
                      sequence="100">
                <menuitem id="money_tracker_currency_config"
                          name="Currencies"
                          sequence="1"
                          action="money_tracker_integration.action_open_mt_currency"/>
                <menuitem id="money_tracker_category_config"
                          name="Categories"
                          sequence="2"
                          action="money_tracker_integration.action_open_mt_category"/>
                <menuitem id="money_tracker_account_config"
                          name="Accounts"
                          sequence="3"
                          action="money_tracker_integration.action_open_mt_account"/>
            </menuitem>
        </menuitem>
    </data>
</odoo>