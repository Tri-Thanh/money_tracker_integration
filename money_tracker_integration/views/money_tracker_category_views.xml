<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="money_tracker_category_view_search" model="ir.ui.view">
            <field name="name">money_tracker_category_view_search</field>
            <field name="model">money_tracker.category</field>
            <field name="arch" type="xml">
                <search>
                    <field name="title"/>
                    <field name="type"/>
                    <group string="Group By">
                        <filter name="groupby_type"
                                string="Type"
                                context="{'group_by': 'type'}"/>
                    </group>
                    <searchpanel>
                        <field name="type" icon="fa-tags" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="money_tracker_category_view_list" model="ir.ui.view">
            <field name="name">money_tracker_category_view_list</field>
            <field name="model">money_tracker.category</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="categoryID" string="ExternalID" optional="hide"/>
                    <field name="title"/>
                    <field name="type"
                           widget="badge"
                           decoration-danger="type == '2'"
                           decoration-success="type == '1'"/>
                </list>
            </field>
        </record>

        <record id="money_tracker_category_action" model="ir.actions.act_window">
            <field name="name">Money Tracker - Categories</field>
            <field name="res_model">money_tracker.category</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="money_tracker_integration.money_tracker_category_view_search"/>
        </record>

        <record id="action_open_mt_category" model="ir.actions.server">
            <field name="name">Money Tracker: Categories</field>
            <field name="path">mt_category</field>
            <field name="model_id" ref="money_tracker_integration.model_money_tracker_category"/>
            <field name="binding_model_id" eval="False"/>
            <field name="state">code</field>
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
            <field name="code">action = model.action_open_data()</field>
        </record>
    </data>
</odoo>