<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_users_form_simple_modif" model="ir.ui.view">
            <field name="name">view_users_form_simple_modif</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page name="money_tracker_references"
                          string="Money Tracker">
                        <group string="Security">
                            <field name="money_tracker_api_token"
                                   string="Token"
                                   password="1"/>
                        </group>
                        <button name="check_mt_response"
                                type="object"
                                class="btn btn-link"
                                invisible="not money_tracker_api_token"
                                string="Check Token"
                        />
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>