<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="money_tracker_account_view_search" model="ir.ui.view">
            <field name="name">money_tracker_account_view_search</field>
            <field name="model">money_tracker.account</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <group string="Group By">
                        <filter name="groupby_type"
                                string="Type"
                                context="{'group_by': 'type'}"
                        />
                    </group>
                    <searchpanel>
                        <field name="type" enable_counters="1" icon="fa-tags"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="money_tracker_account_view_list" model="ir.ui.view">
            <field name="name">money_tracker_account_view_list</field>
            <field name="model">money_tracker.account</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0" expand="context.get('expand')">
                    <field name="display_name"
                           widget="mt_display_remark"
                           options="{'show_remark_label': False}"
                           context="{'with_remark': True}"/>
                    <field name="name" column_invisible="1"/>
                    <field name="remark" column_invisible="1"/>
                    <field name="type"/>
                    <field name="currency_amount"
                           string="Amount"
                           widget="monetary"
                           sum="Total"
                           options="{'currency_field': 'internal_currency_id'}"/>
                    <field name="mt_currency_id" string="Currency" column_invisible="1"/>

                    <field name="internal_currency_id" optional="hide" groups="base.group_no_one"/>
                    <field name="currencyID" optional="hide" groups="base.group_no_one"/>
                </list>
            </field>
        </record>

        <record id="money_tracker_account_action" model="ir.actions.act_window">
            <field name="name">Money Tracker - Accounts</field>
            <field name="res_model">money_tracker.account</field>
            <field name="view_mode">list</field>
            <field name="context">{'with_remark': True, 'search_default_groupby_type': True, 'expand': True}</field>
            <field name="search_view_id" ref="money_tracker_integration.money_tracker_account_view_search"/>
        </record>

        <record id="action_open_mt_account" model="ir.actions.server">
            <field name="name">Money Tracker: Account</field>
            <field name="path">mt_account</field>
            <field name="model_id" ref="money_tracker_integration.model_money_tracker_account"/>
            <field name="binding_model_id" eval="False"/>
            <field name="state">code</field>
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
            <field name="code">action = model.action_open_data()</field>
        </record>
    </data>
</odoo>